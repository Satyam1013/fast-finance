# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/fast-finance

# ─── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# bcrypt rounds for staff/admin passwords
BCRYPT_ROUNDS=12

# ─── OTP (Customer login) ───────────────────────────────────────────────
# Provider not yet chosen — see PRD Open Question #5 / FRS 10.2.
# While unset, OTP is not sent; DEV_OTP is accepted for any number.
OTP_TTL_SECONDS=300
OTP_DEV_MODE=true
OTP_DEV_CODE=000000
SMS_PROVIDER=
SMS_API_KEY=

# ─── Partner ────────────────────────────────────────────────────────────
PARTNER_CODE_PREFIX=FFP

# ─── Account Aggregator (bank statement) — feature flagged ──────────────
# Manual entry is the supported path until AA registration completes.
FEATURE_ACCOUNT_AGGREGATOR=false
AA_PROVIDER=
AA_CLIENT_ID=
AA_CLIENT_SECRET=

# ─── File storage (KYC documents) ──────────────────────────────────────
# S3-compatible. Local disk fallback used when unset.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── GST ───────────────────────────────────────────────────────────────
# Applicable rate — see PRD Open Question #6.
GST_RATE_PERCENT=18
GSTIN=
