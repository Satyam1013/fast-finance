# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/fast-finance

# ─── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# bcrypt rounds for staff/admin passwords
BCRYPT_ROUNDS=12

# ─── OTP (Customer login) ───────────────────────────────────────────────
# Code is 4 digits — matches the mobile app OTP screen.
# OTP_DEV_MODE=true short-circuits delivery: OTP_DEV_CODE is accepted for any
# number and echoed in the response. Set false + OTP_CHANNEL=whatsapp for real.
OTP_TTL_SECONDS=300
OTP_DEV_MODE=true
OTP_DEV_CODE=0000
OTP_LENGTH=4

# Real delivery channel (used when OTP_DEV_MODE=false). WhatsApp only, no SMS.
OTP_CHANNEL=dev
# MacroPage Connect — the in-house WhatsApp platform (POST /api/v1/public/messages/send,
# x-api-key auth). The template must be APPROVED and take ONE body variable (the code).
MACROPAGE_CONNECT_BASE_URL=https://api.macropageconnect.com
MACROPAGE_CONNECT_API_KEY=
MACROPAGE_CONNECT_OTP_TEMPLATE=
MACROPAGE_CONNECT_COUNTRY_CODE=91

# ─── Partner ────────────────────────────────────────────────────────────
PARTNER_CODE_PREFIX=FFP

# ─── Account Aggregator (bank statement) — feature flagged ──────────────
# Manual entry is the supported path until AA registration completes.
FEATURE_ACCOUNT_AGGREGATOR=false
AA_PROVIDER=
AA_CLIENT_ID=
AA_CLIENT_SECRET=

# ─── File storage (KYC docs, profile photos, CMS images) ───────────────
# STORAGE_DRIVER=local  -> ./uploads (ephemeral on Render/DO App Platform)
# STORAGE_DRIVER=s3     -> S3-compatible; configured for DigitalOcean Spaces
# Objects are private; the app serves them via the auth-gated /files/* proxy,
# so PUBLIC_ASSET_BASE_URL should point at <api-host>/api/v1/files.
STORAGE_DRIVER=local
PUBLIC_ASSET_BASE_URL=http://localhost:4000/api/v1/files
# DigitalOcean Spaces example (sfo3 = San Francisco; match your Space's region):
#   S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
#   S3_REGION=sfo3
#   S3_BUCKET=<your-space-name>
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── GST ───────────────────────────────────────────────────────────────
# Applicable rate — see PRD Open Question #6.
GST_RATE_PERCENT=18
GSTIN=

# ─── Support screen (FR-CUS-22) ────────────────────────────────────────
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
SUPPORT_RESPONSE_LABEL=Our team responds within 5 minutes
